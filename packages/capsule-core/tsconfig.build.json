{
  "extends": "../../tsconfig.base.json",
  "//": "The reference is what lets `tsc -b` build capsule-schema first and resolve its emitted declarations here.",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
