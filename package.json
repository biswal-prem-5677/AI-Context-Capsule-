{
  "name": "context-capsule",
  "version": "0.0.0",
  "private": true,
  "description": "Move an AI conversation between ChatGPT, Claude, and Gemini through a reviewed context capsule.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.typecheck.app.json && tsc -p tsconfig.typecheck.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && corepack pnpm --filter @context-capsule/extension build",
    "clean": "tsc -b --clean",
    "check:docs": "node scripts/check-doc-links.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm check:docs",
    "dev:extension": "corepack pnpm --filter @context-capsule/extension dev",
    "dev:dashboard": "node scripts/not-implemented.mjs dev:dashboard M5",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e M2",
    "package:extension": "node scripts/not-implemented.mjs package:extension M4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
